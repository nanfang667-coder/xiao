// 这是 Prisma 的数据库结构定义文件。
// 我们在这里描述"老师"这张表有哪些字段，Prisma 会据此帮我们建数据库。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Each hostname is an acquisition channel. Content stays shared; users, visits, and orders carry siteId.
model Site {
  id                      String              @id
  hostname                String              @unique
  name                    String
  singlePostPrice         Float               @default(10)
  membershipPrice         Float               @default(38)
  membershipOriginalPrice Float               @default(58)
  isDefault               Boolean             @default(false)
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  teamAccounts            TeamAccount[]
  teacherSubmissions      TeacherSubmission[]

  @@index([isDefault, isActive])
}

// Team accounts can access their site's visitor summary and manage their own posts.
model TeamAccount {
  id                Int                 @id @default(autoincrement())
  username          String              @unique
  passwordHash      String
  siteId            String
  monthlyPostLimit  Int                 @default(30) // Allowed values are enforced as 30 or 150 by the admin UI and migration check.
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  sessions          TeamSession[]
  teacherOwnerships TeacherOwnership[]
  submissions       TeacherSubmission[]

  @@index([siteId, isActive])
}

model TeamSession {
  tokenHash     String      @id
  teamAccountId Int
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  account       TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Cascade)

  @@index([teamAccountId])
  @@index([expiresAt])
}

// 管理员会话只保存随机令牌的哈希；浏览器中的原始令牌可单独撤销。
model AdminSession {
  tokenHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Admin login failure counters store only irreversible keys, never raw IP addresses.
model AdminLoginRateLimit {
  keyHash   String   @id
  attempts  Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// 一张"老师"表。每一行 = 一位老师。
model Teacher {
  id                   Int                 @id @default(autoincrement()) // 自动编号，1、2、3……
  name                 String // 标题 / 老师名
  type                 String // 类型："钢琴" 或 "舞蹈"
  city                 String // 城市
  district             String // 区
  price                String // 价格
  services             String // 服务内容
  courseNotes          String? // 教学案例/课程记录（可空，老数据没有）
  age                  String? // 年龄（选填，支持单个数字或区间，如"28"、"25-30"）
  photos               String // 多张照片，存成一段 JSON 文本，例如 ["图1","图2"]
  emoji                String // 照片上的小图标（暂代真实图片）
  phone                String // 联系电话（会员可见）
  wechat               String // 微信号（会员可见）
  qq                   String? // QQ（会员可见，可空）
  otherContact         String? // 其他联系方式（会员可见，可空，如 Telegram/邮箱等）
  address              String? // 详细地址（会员可见，可空，帮学员判断通勤距离）
  createdAt            DateTime            @default(now()) // 创建时间，自动记录
  isNationallyPromoted Boolean             @default(false) // nationwide promotion switch
  promotionOrder       Int                 @default(100) // smaller numbers appear first
  promotionStartsAt    DateTime? // empty means immediately
  promotionEndsAt      DateTime? // empty means no automatic expiry
  source               String?
  sourceId             Int?
  viewCount            Int                 @default(0)
  ownership            TeacherOwnership?
  submissions          TeacherSubmission[]

  @@unique([source, sourceId])
  @@index([city, district, createdAt])
  @@index([createdAt])
  @@index([isNationallyPromoted, promotionOrder, promotionStartsAt, promotionEndsAt])
}

// Ownership is kept outside Teacher so public post queries never load collaborator identity by accident.
model TeacherOwnership {
  teacherId     Int         @id
  teamAccountId Int
  createdAt     DateTime    @default(now())
  teacher       Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  account       TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Restrict)

  @@index([teamAccountId, createdAt])
}

// Collaborator-created and collaborator-edited posts stay here until an administrator reviews them.
// Public pages only read Teacher, so a pending draft can never leak onto the public site.
model TeacherSubmission {
  id            Int         @id @default(autoincrement())
  kind          String // create / update
  status        String      @default("pending") // pending / approved / rejected
  teamAccountId Int
  siteId        String
  teacherId     Int?
  name          String
  type          String
  city          String
  district      String
  price         String
  services      String
  courseNotes   String?
  age           String?
  photos        String
  emoji         String
  phone         String
  wechat        String
  qq            String?
  otherContact  String?
  address       String?
  reviewNote    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reviewedAt    DateTime?
  account       TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Restrict)
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  teacher       Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([teamAccountId, status, updatedAt])
  @@index([teamAccountId, kind, status, createdAt])
  @@index([teacherId, status])
  @@index([siteId, status])
}

// SPA 商家独立于老师资料，联系方式按产品决定对所有访客公开。
model Merchant {
  id           Int      @id @default(autoincrement())
  name         String
  city         String
  district     String
  price        String?
  services     String
  description  String?
  photos       String
  phone        String?
  wechat       String?
  qq           String?
  otherContact String?
  address      String?
  sortOrder    Int      @default(100) // smaller numbers appear first
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder, createdAt])
  @@index([city, district, sortOrder])
}

// 暗巷列表封面公开；详细介绍和详情图片仅会员可见。
model AlleyPost {
  id           Int      @id @default(autoincrement())
  title        String
  city         String
  district     String
  address      String
  coverPhoto   String
  description  String
  detailPhotos String
  sortOrder    Int      @default(100)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder, createdAt])
  @@index([city, district, sortOrder])
}

// 首页合作伙伴/友情链接；不抓取外部网页，只保存管理员填写的公开链接。
model PartnerLink {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  description String?
  linkType    String   @default("exchange") // exchange / sponsored
  sortOrder   Int      @default(100)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder, createdAt])
}

// 用户表（普通用户）
model User {
  id                  Int             @id @default(autoincrement())
  username            String          @unique // 登录账号，必须唯一
  email               String?         @unique // 绑定邮箱（选填，可为空；填了则必须唯一，不需要验证真实性）
  passwordHash        String // 加密后的密码（不要存明文！）
  isMember            Boolean         @default(false) // 是否为会员
  membershipExpiresAt DateTime? // 会员到期时间（空表示永久或非会员）
  memberSince         DateTime? // 最近一次从非会员变成会员的时间（用于统计新增会员），续费/延期不会更新这个时间
  referralCode        String          @unique // 该用户自己的专属邀请码
  referredBy          Int? // 谁邀请来的（User.id），只在注册时写入一次，此后不变
  registrationIp      String? // 注册时的IP，用于识别同一IP短时间内批量注册
  isBanned            Boolean         @default(false) // 是否被封禁（自动检测批量注册，或管理员手动封禁）
  bannedAt            DateTime? // 封禁时间
  banReason           String? // 封禁原因
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  siteId              String          @default("a") // Immutable acquisition site selected at registration.
  referralVisits      ReferralVisit[]

  @@index([siteId, createdAt])
  @@index([siteId, isMember, memberSince])
}

// 邀请链接的匿名独立访客。每位浏览器访问同一用户的邀请链接只占一行，
// visitCount 记录重复访问次数；visitorKey 是按邀请人隔离的匿名哈希，不保存原始 IP。
model ReferralVisit {
  id             Int      @id @default(autoincrement())
  referrerId     Int
  visitorKey     String
  visitCount     Int      @default(1)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt  DateTime @default(now())
  referrer       User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, visitorKey])
  @@index([referrerId, lastVisitedAt])
}

// 全站匿名独立访客。直接访问域名和通过邀请链接进入都会记录。
model SiteVisit {
  id             Int      @id @default(autoincrement())
  visitorKey     String   @unique
  visitCount     Int      @default(1)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt  DateTime @default(now())
  siteId         String   @default("a")

  @@index([siteId, lastVisitedAt])
  @@index([lastVisitedAt])
}

// 支付订单表。每一行 = 一笔会员、暗巷单篇或按摩帖子单篇解锁订单。
// 现在支付确认由页面按钮触发；未来接入支付宝/微信后，改由支付回调把 status 置为 paid。
model Order {
  id               Int       @id @default(autoincrement())
  userId           Int // 下单用户
  plan             String // 商品名称，如“永久会员”或“单篇永久解锁”
  amount           Float // 金额（元），如 38 或 10
  productType      String    @default("membership") // membership / alley_post / teacher_post
  alleyPostId      Int? // 暗巷单篇解锁编号；其它订单为空
  teacherPostId    Int? // 按摩帖子单篇解锁编号；其它订单为空
  payMethod        String // 支付方式："wechat" 微信 / "alipay" 支付宝
  status           String    @default("pending") // pending 待支付 / paid 已支付
  merchantOrderNo  String?   @unique // 本站提交给支付平台的唯一订单号
  providerTradeNo  String?   @unique // 支付平台订单号
  paymentUrl       String? // 支付平台返回的收银台地址
  paymentExpiresAt DateTime? // 收银台地址过期时间
  paymentCheckedAt DateTime? // 最近一次主动查单时间（用于限流）
  createdAt        DateTime  @default(now())
  paidAt           DateTime? // 支付完成时间

  siteId String @default("a") // Snapshot of the checkout site for immutable revenue attribution.

  @@index([siteId, status, paidAt])
  @@index([siteId, createdAt])
  @@index([userId, productType, alleyPostId, status])
  @@index([userId, productType, teacherPostId, status])
}

// 推广佣金记录。每一行 = 一笔"被邀请人开通会员"产生的佣金。
// orderId 加 unique：保证一笔订单只能产生一次佣金，防止重复入账。
model Commission {
  id           Int      @id @default(autoincrement())
  referrerId   Int // 拿佣金的人（推荐人）
  orderId      Int      @unique // 对应哪笔会员订单
  amount       Float // 佣金金额（人民币）
  withdrawalId Int? // 归入哪一笔提现申请；还没提现时为 null
  createdAt    DateTime @default(now())
}

// 提现申请。每一行 = 一次佣金提现请求（人工审核后手动转账）。
model Withdrawal {
  id        Int       @id @default(autoincrement())
  userId    Int
  amount    Float // 本次提现总额（人民币）
  payMethod String // 收款方式："usdt" / "alipay" / "wechat"
  account   String // 收款账号：USDT地址 / 支付宝账号 / 微信收款码或账号
  network   String? // 仅 payMethod 为 "usdt" 时使用，网络类型如 "TRC20"
  status    String    @default("pending") // pending 待处理 / paid 已发放 / rejected 已驳回
  createdAt DateTime  @default(now())
  paidAt    DateTime?
}
