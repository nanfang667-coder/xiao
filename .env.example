# Server-only token for https://api.lfgapi.com. Never prefix this with NEXT_PUBLIC_.
LFG_API_TOKEN=

# 千禾支付配置（仅放在服务器环境变量中，禁止使用 NEXT_PUBLIC_ 前缀）
PAYMENT_FEATURE_ENABLED=false
PAYMENT_SITE_URL=https://fenglou1.com
QIANHE_MCH_ID=
QIANHE_MCH_KEY=
QIANHE_ALIPAY_WAY_CODE=7888

# 暗巷后台始终可管理；公开入口关闭时，首页和站点地图不会展示暗巷。
ALLEY_PUBLIC_ENABLED=false
# 默认允许知道网址的人直接访问；设为 false 才会让 /alley 返回 404。
ALLEY_DIRECT_ACCESS_ENABLED=true
